{
  "name": "remotion-tech-training-studio",
  "version": "1.0.0",
  "private": true,
  "description": "PC/Laptop Industry Technology Training Video Studio powered solely by Remotion, with PPTX/PDF/Research enhancement, 10-minute scene scripting, and OpenFormosa + Ming-3.0-TTS voiceover.",
  "scripts": {
    "dev": "concurrently -n \"WEB,API,TTS\" -c \"cyan,magenta,yellow\" \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:tts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:tts": "node server/startBlueMagpie.mjs",
    "build": "vite build",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "train:auto": "tsx scripts/auto-video.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.82",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@remotion/bundler": "^4.0.545",
    "@remotion/captions": "^4.0.545",
    "@remotion/cli": "^4.0.545",
    "@remotion/google-fonts": "^4.0.545",
    "@remotion/layout-utils": "^4.0.545",
    "@remotion/media": "^4.0.545",
    "@remotion/media-utils": "4.0.545",
    "@remotion/paths": "4.0.545",
    "@remotion/player": "^4.0.545",
    "@remotion/preload": "^4.0.545",
    "@remotion/renderer": "^4.0.545",
    "@remotion/three": "^4.0.545",
    "@remotion/transitions": "^4.0.545",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.1.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.545",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.2",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^5.1.1"
  }
}
